{
  "device": {
    "id": "rpi-edge-001",
    "location": "lab-bioreactor-1"
  },
  "sampling": {
    "sensor_interval": 5,
    "spectra_interval": 60,
    "retry_upload_interval": 300
  },
  "aws": {
    "region": "eu-west-1", 
    "iot_topic": "microalgae/data",
    "s3_bucket": "microalgae-spectra",
    "timestream_db": "microalgae_monitoring"
  },
  "paths": {
    "db": "./data/edge_data.db",
    "spectra_dir": "./data/spectra",
    "logs_dir": "./data/logs"
  },
  "mqtt": {
    "broker": "localhost",
    "port": 1883,
    "topic_spectra": "nir/spectra",
    "topic_sensors": "edge/sensors"
  },
  "sensors": [
    {
      "name": "Tank-A-Temp",
      "type": "Temperature",
      "unit": "Celsius",
      "enabled": true,
      "simulator_params": {
        "min_val": 22.0,
        "max_val": 26.0,
        "period_seconds": 3600,
        "noise": 0.1
      }
    },
    {
      "name": "Tank-A-pH",
      "type": "pH",
      "unit": "pH",
      "enabled": true,
      "simulator_params": {
        "min_val": 7.8,
        "max_val": 8.2,
        "period_seconds": 7200,
        "noise": 0.05
      }
    },
    {
      "name": "Tank-A-IonicStrength",
      "type": "IonicStrength",
      "unit": "mS/cm",
      "enabled": true,
      "simulator_params": {
        "min_val": 45.0,
        "max_val": 55.0,
        "period_seconds": 86400,
        "noise": 0.5
      }
    },
    {
      "name": "Room-A-LightIntensity",
      "type": "LightIntensity",
      "unit": "µmol/m²/s",
      "enabled": true,
      "simulator_params": {
        "min_val": 50.0,
        "max_val": 400.0,
        "period_seconds": 43200,
        "noise": 10
      }
    },
    {
      "name": "Disabled-Sensor-Example",
      "type": "Temperature",
      "unit": "Celsius",
      "enabled": false,
      "simulator_params": {}
    }
  ]
}
