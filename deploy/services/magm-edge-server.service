[Unit]
Description=MAGM Edge Server
After=network.target

[Service]
Type=simple
User=rpi
WorkingDirectory=/home/rpi/Desktop/magm_edge_server
ExecStart=/home/rpi/Desktop/magm_edge_server/env/bin/python /home/rpi/Desktop/magm_edge_server/src/edge_server/main.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
